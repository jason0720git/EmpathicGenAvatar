# Control API
APP_DATA_DIR=./data
DATABASE_PATH=./data/empathic.db
ALLOWED_ORIGINS=http://localhost:5173
# Set APP_ENV=production only with an authentication gateway. This temporary
# single-tenant token is useful for private testing, not browser-user auth.
# APP_ENV=development
# API_ACCESS_TOKEN=

# Local LLM. Leave empty to use the deterministic privacy-safe demo responder.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2:3b

# Avatar engine mode. "preview" works out of the box; "remote" forwards the
# documented prepare/render contract to your GPU renderer service.
AVATAR_ENGINE=preview
# AVATAR_RENDERER_URL=http://avatar-worker:8010
# WORKER_SHARED_TOKEN=

# Browser app. Vite proxies /api and /ws in development, so this can normally
# remain empty.
# VITE_API_BASE_URL=
# VITE_API_ACCESS_TOKEN=
