# Isolated research environment. Never install these packages in the live A2F worker.
FROM empathic-avatar-gaussian-worker:latest
ENV TORCH_CUDA_ARCH_LIST="12.0" MAX_JOBS=4 TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
ENV PYTHONPATH=/workspace/vendor/CAP4D
RUN python -m pip install --no-cache-dir pytorch-lightning==2.6.6 einops==0.8.2 decord==0.6.0 gsplat==1.5.3 roma==1.6.1 open_clip_torch==3.3.0 kornia==0.8.3
WORKDIR /workspace/vendor/CAP4D
CMD ["sleep", "infinity"]
